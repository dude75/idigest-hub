# Example nginx site for idigest-hub.
# Copy to /etc/nginx/sites-available/ (Debian/Ubuntu) or include from nginx.conf.
#
# Prerequisites on the hub host (.env):
#   TRUSTED_PROXIES=127.0.0.1,::1
#   COOKIE_SECURE=true
# Set Public URL in Instance → Settings to https://hub.example.com
#
# Hub on the same host (HTTP localhost; default):
#   python -m app.serve   # HOST=127.0.0.1 PORT=8080 in .env
#
# Hub on another host (HTTPS over LAN; set on hub .env):
#   PORT=8443
#   SSL_CERTFILE=/data/certs/hub.crt
#   SSL_KEYFILE=/data/certs/hub.key
#   TRUSTED_PROXIES=<nginx LAN IP>
#   COOKIE_SECURE=true
#
# Docker Compose: if nginx runs on the host and hub in a container on 8080,
# TRUSTED_PROXIES=127.0.0.1,::1 still applies. If nginx is another container
# on the same Docker network, add that network CIDR (e.g. 172.18.0.0/16).

upstream idigest_hub {
    server 127.0.0.1:8080;
    keepalive 8;
}

# Remote hub with TLS (uncomment and adjust IP/port; copy hub.crt for proxy_ssl_trusted_certificate):
# upstream idigest_hub {
#     server 10.0.1.50:8443;
#     keepalive 8;
# }

# Redirect HTTP → HTTPS (adjust server_name and certificate paths).
server {
    listen 80;
    listen [::]:80;
    server_name hub.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hub.example.com;

    # TLS certificates (Let's Encrypt, internal CA, etc.)
    ssl_certificate     /etc/ssl/certs/hub.example.com.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/hub.example.com.key;

    # Large audio uploads (adjust to your max upload size policy).
    client_max_body_size 1024m;

    # Security headers (HTTPS only — never send HSTS on port 80).
    # Adjust CSP if you add external scripts/CDNs or need a looser policy for /docs.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" always;

    location / {
        proxy_pass http://idigest_hub;
        # For HTTPS upstream (remote hub): proxy_pass https://idigest_hub;
        #   proxy_ssl_verify on;
        #   proxy_ssl_trusted_certificate /etc/ssl/certs/hub.crt;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
