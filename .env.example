# Copy to .env and fill in. Do not commit .env.

HUB_SECRET=change-me
INSTANCE_BOOTSTRAP_TOKEN=change-me
SESSION_SECRET=change-me

HOST=127.0.0.1
PORT=8080

DATA_DIR=./data
DATABASE_URL=sqlite:///./data/hub.db

# PostgreSQL (docker compose --profile pg up):
# DATABASE_URL=postgresql+psycopg://hub:hub@postgres:5432/hub
# POSTGRES_USER=hub
# POSTGRES_PASSWORD=hub
# POSTGRES_DB=hub

LOG_DIR=./data/logs
LOG_ENABLED=true
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Set true behind HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
