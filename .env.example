# Copy to .env and fill in. Do not commit .env.

HUB_SECRET=change-me
INSTANCE_BOOTSTRAP_TOKEN=change-me
SESSION_SECRET=change-me

HOST=127.0.0.1
PORT=8080

DATA_DIR=./data
DATABASE_URL=sqlite:///./data/hub.db

# Audio storage: local (default) or S3-compatible object storage.
# STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://s3.storage.selcloud.ru
# S3_BUCKET=idigest-audio
# S3_REGION=ru-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SSE=AES256          # AWS S3 only
# S3_SSE=aws:kms         # Yandex Object Storage (requires S3_SSE_KMS_KEY_ID)
# S3_SSE=                # omit header — use bucket default encryption (recommended for Yandex)
# S3_SSE_KMS_KEY_ID=     # KMS key ID when S3_SSE=aws:kms

# PostgreSQL (docker compose --profile pg up):
# DATABASE_URL=postgresql+psycopg://hub:hub@postgres:5432/hub
# POSTGRES_USER=hub
# POSTGRES_PASSWORD=hub
# POSTGRES_DB=hub

LOG_DIR=./data/logs
LOG_ENABLED=true
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Set true behind HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false

# Comma-separated IPs/CIDRs of reverse proxies that may set X-Forwarded-For / X-Real-IP.
# Empty = trust none (TCP peer only; safe when hub is reachable directly).
# Example (nginx on same host): TRUSTED_PROXIES=127.0.0.1,::1
# TRUSTED_PROXIES=
